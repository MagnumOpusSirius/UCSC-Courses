# quiz part (g): likelihood inferential analysis
print(
theta.hat.mle <- s / n
)
# [1] 2.071429
print(
observed.information <- n / theta.hat.mle
)
# [1] 6.758621
print(
se.hat.theta.hat.mle <- sqrt( 1 / observed.information )
)
# [1] 0.3846546
alpha.star <- 0.001
print(
z.alpha.star <- qnorm( 1 - alpha.star / 2 )
)
print(
large.sample.confidence.interval.for.theta <-
c( theta.hat.mle - z.alpha.star * se.hat.theta.hat.mle,
theta.hat.mle + z.alpha.star * se.hat.theta.hat.mle
)
)
