#   (V) statistical inference, including model checking
# quiz part (c)(i)
# define the likelihood and log likelihood functions
poisson.likelihood <- function( theta, y, c.plus ) {
n <- length( y )
s <- sum( y )
result <- c.plus * theta^s * exp( - n * theta )
return( result )
}
poisson.log.likelihood <- function( theta, y, cc ) {
n <- length( y )
s <- sum( y )
result <- cc + s * log( theta ) - n * theta
return( result )
}
#   (V) statistical inference, including model checking
# quiz part (c)(i)
# define the likelihood and log likelihood functions
poisson.likelihood <- function( theta, y, c.plus ) {
n <- length( y )
s <- sum( y )
result <- c.plus * theta^s * exp( - n * theta )
return( result )
}
poisson.log.likelihood <- function( theta, y, cc ) {
n <- length( y )
s <- sum( y )
result <- cc + s * log( theta ) - n * theta
return( result )
}
