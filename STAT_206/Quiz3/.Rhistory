# quiz part (l): frequentist bootstrap as a
# bayesian nonparametric inferential meethod
# bootstrapping the sample mean
seed <- 20221031
set.seed( seed )
M <- 1000000
theta.star <- rep( NA, M )
system.time( {
for ( m in 1:M ) {
y.star <- sample( y, n, replace = T )
theta.star[ m ] <- mean( y.star )
if ( ( m %% 10000 ) == 0 ) print( m )
}
} )
#   user  system elapsed
#  21.78    1.86   23.84
hist( theta.star, prob = T, xlab = 'theta', ylab = 'Posterior PDF',
col = 'darkcyan', main = '' )
lines( theta.grid, dgamma( theta.grid, alpha.posterior, beta.posterior ),
lwd = 3, col = 'darkred', lty = 2 )
c( mean( theta.star ), sd( theta.star ) )
# [1] 2.071040 0.396543
quantile( theta.star, c( alpha.star / 2, 1 - alpha.star / 2 ) )
#    0.05%   99.95%
# 1.000000 3.571429
# stop here and examine the plot and the numerical results before
continuing
# the posterior predictive distribution in this [SM] is called the
#   gamma-poisson mixture distribution (PMF)
# this distribution is not part of the standard set of R PMFs,
# but it's available through CRAN in the package
#   extraDistr
# here's a useful helper function that
#   tries to bring a CRAN package into the current R workspace;
#   if it's already installed, it brings it in with a call to 'require';
#   if not, it calls 'install.packages' (in this case you may need
#   to choose a mirror site) and then calls 'require'
dynamic.require <- function( package ) {
if ( eval( parse( text = paste( 'require(', package, ')' ) ) ) ) {
return( 'done' )
}
install.packages( package )
return( eval( parse( text = paste( 'require(', package, ')' ) ) ) )
}
dynamic.require( 'extraDistr' )
# it's also easy to code up a homegrown version:
gamma.poisson.pmf <- function( y, alpha, beta ) {
log.pmf <- lgamma( alpha + y ) + alpha *
log( beta / ( beta + 1 ) ) - y * log( beta + 1 ) -
lgamma( alpha ) - lgamma( y + 1 )
result <- exp( log.pmf )
return( result )
}
