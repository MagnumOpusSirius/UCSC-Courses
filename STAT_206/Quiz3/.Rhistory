type = 'l', lwd = 3, xlab = 'theta', ylab = 'Likelihood', col =
'darkcyan' )
plot( theta.grid, poisson.log.likelihood( theta.grid, y, cc ),
type = 'l', lwd = 3, xlab = 'theta', ylab = 'Log Likelihood', col =
'darkcyan' )
