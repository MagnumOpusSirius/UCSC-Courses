# the next set of function calls compares the empirical relative frequencies
# in the data set y with poisson pmf probabilities, using the mle for theta
# to identify the best-fitting poisson distribution (i've edited the output
# a bit to clarify which column is which)
cbind( 0:7, apply( outer( y, 0:7, '==' ), 2, sum ) / n,
c( dpois( 0:6, theta.hat.mle ), 1 - sum( dpois( 0:6, theta.hat.mle ) ) )
)
